{:paths ["src" "resources"]
 ;; Current transit rather than the 77e3ce7d that sheets and docs pin:
 ;; :forms/form is only an admitted office resource kind here. See
 ;; forms.wire's docstring for what that costs on the read side.
 :deps {io.github.kotoba-lang/transit
        {:git/url "https://github.com/kotoba-lang/transit.git"
         :git/sha "ab5d9d956e088d77d7f91357f36a4a0c6bdfcadc"}}
 :aliases
 {:test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}
       ;; clj-kondo as a Clojars lib (no Homebrew/system install needed).
       :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts ["-m" "clj-kondo.main" "--lint" "src" "test"
                     "--fail-level" "error"]}}}
